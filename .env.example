# ─────────────────────────────────────────────────────────────
# Bob the AI Mixologist — environment variables
# Copy this file to `.env.local` and fill in your own values.
# ─────────────────────────────────────────────────────────────

# Supabase — https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key. NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# AI mode: set to "mock" to use built-in mock responses (no API calls / no cost),
# or "openai" to call the real OpenAI API. Defaults to "mock" when unset.
AI_MODE=mock

# Models (only used when AI_MODE=openai)
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Free monthly image-generation allowance per user (recipes/plans are unlimited)
FREE_PLAN_MONTHLY_IMAGES=5

# Affiliate / "shop the ingredients" links (all optional).
# Amazon Associates tracking tag, e.g. bobmixology-21. When set, it's appended
# to Amazon search links. Tesco/Ocado typically go through an affiliate network
# (e.g. Awin) — see TODO(affiliate) in lib/affiliates.ts.
AMAZON_AFFILIATE_TAG=
